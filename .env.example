# Copy to .env to override the dev defaults; docker compose reads it automatically.
POSTGRES_DB=dss
POSTGRES_USER=dss
POSTGRES_PASSWORD=dss
DB_PORT=5433
API_PORT=8000
# At least 32 characters. Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-dev-only-insecure-secret-key-0123456789
